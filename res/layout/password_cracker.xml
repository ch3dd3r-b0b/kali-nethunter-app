<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password Cracker"
            android:textSize="24sp"
            android:textStyle="bold"
            android:paddingBottom="16dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Engine"/>

        <Spinner
            android:id="@+id/pc_engine"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Attack Mode"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/pc_attack"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hash Type / Format"
            android:layout_marginTop="12dp"/>

        <Spinner
            android:id="@+id/pc_hash_type"
            android:layout_width="match_parent"
            android:layout_height="48dp"/>

        <EditText
            android:id="@+id/pc_hash_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Kali hash path (e.g. /root/hashes.txt)"
            android:inputType="textUri"/>

        <Button
            android:id="@+id/pc_browse_hash"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Hash File (Optional)"/>

        <EditText
            android:id="@+id/pc_wordlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="/usr/share/wordlists/rockyou.txt"
            android:inputType="textUri"
            android:layout_marginTop="12dp"/>

        <Button
            android:id="@+id/pc_browse_wordlist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Wordlist (Optional)"/>

        <EditText
            android:id="@+id/pc_rules"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rule path / John ruleset"/>

        <EditText
            android:id="@+id/pc_mask"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Mask (e.g. ?u?l?l?l?d?d?d?d)"/>

        <EditText
            android:id="@+id/pc_session"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Session name"
            android:text="nethunter"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Command Preview"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/pc_command_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="64dp"
            android:padding="12dp"
            android:text="Configure an attack to preview the command."
            android:textIsSelectable="true"
            android:background="#202020"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/pc_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate Command"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/pc_start"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Start"/>

            <Button
                android:id="@+id/pc_stop"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop"
                android:enabled="false"/>

            <Button
                android:id="@+id/pc_resume"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Resume"/>
        </LinearLayout>

        <!-- Recovered password results -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cracking Results"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:id="@+id/pc_result_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Idle"
            android:textStyle="bold"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"/>

        <TextView
            android:id="@+id/pc_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="90dp"
            android:padding="12dp"
            android:text="No results yet."
            android:textIsSelectable="true"
            android:textColor="#FFFFFF"
            android:background="#202020"
            android:typeface="monospace"/>

        <Button
            android:id="@+id/pc_copy_results"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Results"
            android:enabled="false"/>

        <!-- Session console -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Session Output"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/pc_clear_output"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear"/>
        </LinearLayout>

        <TextView
            android:id="@+id/pc_output"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:padding="12dp"
            android:gravity="top"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:text="No active session."
            android:textColor="#FFFFFF"
            android:background="#202020"
            android:textSize="12sp"
            android:typeface="monospace"/>

    </LinearLayout>
</ScrollView>
